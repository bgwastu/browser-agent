{
  "name": "browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An MCP server that lets AI agents use your own browser through a Chrome extension. Each agent gets its own tab group.",
  "license": "MIT",
  "scripts": {
    "start": "bun server/src/index.ts",
    "dev": "bun --watch server/src/index.ts",
    "build:extension": "bun extension/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "test": "bun test",
    "test:e2e": "BROWSER_E2E=1 bun test e2e.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.1.0",
    "typescript": "^5.9.0"
  }
}
