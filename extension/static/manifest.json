{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "0.3.0",
  "description": "Lets AI agents use your browser tabs through the browser-agent MCP server. Each agent gets its own tab group.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ]
}
